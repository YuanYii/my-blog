# ============================================================
# my-blog 数据恢复专用 sudoers 白名单
# ============================================================
# 部署到生产:
#   sudo install -m 0440 sudoers-myblog-restore.example /etc/sudoers.d/myblog-restore
#   sudo visudo -c -f /etc/sudoers.d/myblog-restore
#
# 设计依据: docs/设计文档/博客数据恢复方案设计.md §12.1
# 版本: v4.3.0 (REQ-RESTORE-2026-06-20)
#
# 关键约束 (踩过的坑):
#   - 末尾**不能**用 * 通配符 → myblog 可 sudo ... bash -i 拿 root shell (致命)
#   - 精确到脚本路径, --unit 前缀限制为 blog-restore-*
#   - --uid=myblog --gid=myblog 必须有, scope 内进程才能以 myblog 身份跑 (否则 root)
#
# 总计 5 条 (3 systemctl + 1 chown + 1 systemd-run 精确路径)
# ============================================================

# ---------- 停/启/查 myblog 服务 ----------
myblog ALL=(root) NOPASSWD: /usr/bin/systemctl stop myblog
myblog ALL=(root) NOPASSWD: /usr/bin/systemctl start myblog
myblog ALL=(root) NOPASSWD: /usr/bin/systemctl is-active myblog

# ---------- 改文件属主 (恢复后 Spring Boot 要能写 db / uploads) ----------
# v4.3.2: 精确到 SQLITE_PATH + UPLOADS_DIR 两个具体路径, 不用 /opt/myblog/* 通配符
#   之前用 /opt/myblog/* 的风险: myblog 可 sudo chown /opt/myblog/../../etc/shadow
#   之类的路径穿越 (虽然 chown 目标是 myblog:myblog 不是 root, 但能把系统文件属主改了)
myblog ALL=(root) NOPASSWD: /usr/bin/chown -R myblog\:myblog /opt/myblog/blog.db
myblog ALL=(root) NOPASSWD: /usr/bin/chown -R myblog\:myblog /opt/myblog/blog.db.bak.*
myblog ALL=(root) NOPASSWD: /usr/bin/chown -R myblog\:myblog /opt/myblog/uploads
myblog ALL=(root) NOPASSWD: /usr/bin/chown -R myblog\:myblog /opt/myblog/uploads/*

# ---------- v4 关键: systemd-run 创建独立 cgroup, 跑恢复脚本 ----------
# 末尾精确到脚本路径, 无通配符:
#   ✅ 允许: sudo ... --unit=blog-restore-123 /bin/bash /opt/myblog/scripts/blog-restore.sh
#   ❌ 拒绝: sudo ... /bin/bash -i
#   ❌ 拒绝: sudo ... --slice=other-slice /bin/bash ...
#   ❌ 拒绝: sudo ... /bin/bash  (不带脚本绝对路径)
myblog ALL=(root) NOPASSWD: /usr/bin/systemd-run --scope --slice=myblog-restore --unit=blog-restore-* --uid=myblog --gid=myblog /bin/bash /opt/myblog/scripts/blog-restore.sh