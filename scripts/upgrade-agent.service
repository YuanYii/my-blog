[Unit]
Description=Blog Upgrade Agent
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/myblog
ExecStart=/usr/bin/python3 /opt/myblog/scripts/upgrade-agent.py
Restart=on-failure
RestartSec=5
Environment=AGENT_HOST=127.0.0.1
Environment=AGENT_PORT=28081
Environment=DEPLOY_SCRIPT=/opt/myblog/scripts/deploy-server.sh
Environment=GITHUB_REPO=YuanYii/my-blog

[Install]
WantedBy=multi-user.target
