# ============================================================
# my-blog 顶层 .gitignore
# 覆盖范围：Java 后端（backend/）+ Nuxt 3 前端（frontend/）
# + docs/ + 顶层项目级产物
# ============================================================

# ----------------------------------------------------------------
# Java / Maven / Spring Boot（backend/）
# ----------------------------------------------------------------
**/target/
**/*.class
**/*.jar
**/*.war
**/*.ear
**/logs/
**/*.log

# Maven 本地仓库元数据
.mvn/
mvnw
mvnw.cmd
.mvn/wrapper/maven-wrapper.jar

# IDE Java 配置
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.factorypath
.apt_generated/
.springBeans

# Spring Boot devtools
.springBeans
.spring-boot-devtools.properties

# 上传文件目录（运行时写到 ./tmp/blog-uploads）
**/tmp/
/backend/**/tmp/


# ----------------------------------------------------------------
# Nuxt 3 / Vue 3（frontend/）
# ----------------------------------------------------------------
# Build / Runtime 产物
**/.nuxt/
**/.nuxt-tmp/
**/.output/
**/.nitro/
**/.cache/
**/.tmp/
**/dist/

# Node
**/node_modules/
package-lock.json.bak

# 环境变量
.env
.env.local
.env.*.local
# 2026-06-22: 早期 docker 部署时代残留,已删
# .env.prod.example → 部署配置统一走 docs/scripts/deploy-server.env.example

# 部署脚本的本地环境（含 GitHub token）—— 永远不要 commit
docs/scripts/deploy.env
docs/scripts/deploy-server.env.example
docs/scripts/*.env.local

# TypeScript 增量编译
**/*.tsbuildinfo

# Lint 缓存
**/.eslintcache
**/.stylelintcache

# 覆盖率（无单测时不会生成，未来接入 vitest 后用）
**/coverage/
**/.nyc_output/
**/*.lcov

# ----------------------------------------------------------------
# 项目级 / 跨语言共用
# ----------------------------------------------------------------
# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# 日志
*.log
logs/

# 注：docs/scripts/deploy-server.env.example 是部署模板（不入库,本地运维用）
# .env.prod.example 早期 docker 时代残留,2026-06-22 已删。

# 临时脚本 / 报告（不要 commit 过程文件）
/tmp/
docs/scripts/.tmp/

# Agent / Claude 工具配置（不要进仓库）
.audit/
.claude/
.cursor/
.workbuddy
.aider*

# 本地运维脚本草稿（按需）
docs/auto_fix/
docs/audits
docs/changelogs

# 2026-06-17 v2.6.0：本地 SQLite db（dev 用）
backend/blog.db
backend/blog.db-journal
backend/blog.db-wal
backend/blog.db-shm
backend/tmp/
backend/blog-app/blog.db
backups

frontend/dist
