<?xml version="1.0" encoding="UTF-8"?>
<!--
  服务日志体系（REQ-LOG-2026-06-18）—— Logback 主配置

  设计要点（对应需求文档 FR/NFR）：
  - FR-1.1 配置独立于 jar：本文件随 jar 打包，日志目录由 LOG_DIR 决定，dev/prod 分离
  - FR-1.2/1.3 按天滚动 + 单文件 100MB 切割：SizeAndTimeBasedRollingPolicy
  - FR-1.4/1.5 30 天清理 + 总容量上限：maxHistory=30 + totalSizeCap
  - FR-1.7 异步写：AsyncAppender(neverBlock=true)，业务线程不被日志阻塞
  - FR-5.2 traceId：pattern 里 %X{traceId} 自动带上 MDC 中的 traceId（由 TraceIdFilter 注入）
  - FR-6.1 com.blog 默认 INFO；FR-6.2 org.springframework WARN
  - FR-6.3 PageViewFilter/PageViewService 单独 WARN（高频访问降噪）
  - FR-6.4 dev：CONSOLE + FILE 双写；FR-6.5 prod：必须关闭 CONSOLE（防 systemd app.log 双写绕过 3GB 预算）
  - NFR-3 容量：主日志 totalSizeCap=2GB + warn 日志 1GB = 3GB Logback 预算上限
  - NFR-4 异常退出仍落盘：shutdownHook 在关闭时 flush 异步队列

  文件命名（必须与 scripts/deploy-server.sh 的 logrotate glob 对齐）：
  - 全量：blog.log（活动）+ blog-YYYY-MM-DD.N.log（归档）  → 命中 logrotate `blog-*.log`
  - WARN+：blog-warn.log（活动）+ blog-warn-YYYY-MM-DD.N.log（归档） → 命中 `blog-warn-*.log`
-->
<configuration scan="false">

    <!-- ============ 日志目录：dev/prod 路径分离（FR-1.6） ============ -->
    <!-- prod 落部署目录；非 prod（dev/test/无 profile）落 /tmp 临时目录 -->
    <springProfile name="prod">
        <property name="LOG_DIR" value="/opt/myblog/logs"/>
    </springProfile>
    <springProfile name="!prod">
        <property name="LOG_DIR" value="/tmp/blog-dev-logs"/>
    </springProfile>

    <!-- 日志行格式：时间 级别 [线程] [traceId] logger - msg -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{traceId:-}] %logger{36} - %msg%n"/>

    <!-- 关闭时延迟退出，给异步队列 flush 的机会（NFR-4） -->
    <shutdownHook class="ch.qos.logback.core.hook.DelayingShutdownHook"/>

    <!-- ============ CONSOLE（仅 dev 引用，prod 不挂） ============ -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ============ 全量文件（INFO 及以上，按天+100MB 滚动） ============ -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/blog.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 按天 + 单文件 100MB 切割（FR-1.2/1.3） -->
            <fileNamePattern>${LOG_DIR}/blog-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <!-- 30 天保留（FR-1.4 / 决策记录：统一 30 天） -->
            <maxHistory>30</maxHistory>
            <!-- 全量日志总容量上限 2GB（NFR-3：与 warn 的 1GB 合计 3GB Logback 预算） -->
            <totalSizeCap>2GB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <!-- ============ WARN+ 文件（便于排查时只看告警/错误） ============ -->
    <appender name="FILE_WARN" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/blog-warn.log</file>
        <!-- 只收 WARN 及以上 -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/blog-warn-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <!-- ============ 异步包装（FR-1.7 / RISK-2：neverBlock 丢日志不阻塞业务） ============ -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE"/>
        <queueSize>512</queueSize>
        <!-- discardingThreshold=0：队列满前不主动丢 INFO/DEBUG（个人站日志量小，尽量保全） -->
        <discardingThreshold>0</discardingThreshold>
        <!-- neverBlock=true：队列满时直接丢弃而非阻塞业务线程（NFR-1 P99 敏感） -->
        <neverBlock>true</neverBlock>
    </appender>

    <appender name="ASYNC_FILE_WARN" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE_WARN"/>
        <queueSize>256</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
    </appender>

    <!-- ============ 降噪：分包级别（FR-6.1/6.2/6.3） ============ -->
    <!-- Spring 框架包默认 WARN，压掉启动/框架噪声 -->
    <logger name="org.springframework" level="WARN"/>
    <!-- MyBatis-Plus SQL 默认 WARN（不打印 SQL，沿用现状） -->
    <logger name="com.baomidou.mybatisplus" level="WARN"/>
    <!-- 高频访问统计链路单独压到 WARN，防 INFO 爆磁盘（FR-6.3 / RISK-4） -->
    <logger name="com.blog.article.security.PageViewFilter" level="WARN"/>
    <logger name="com.blog.article.service.PageViewService" level="WARN"/>

    <!-- ============ root：dev 双写 + prod 仅文件（FR-6.4/6.5） ============ -->
    <springProfile name="prod">
        <!-- prod：业务包 INFO；root INFO；**不挂 CONSOLE**（FR-6.5 强制） -->
        <logger name="com.blog" level="INFO"/>
        <root level="INFO">
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ASYNC_FILE_WARN"/>
        </root>
    </springProfile>

    <springProfile name="!prod">
        <!-- dev：业务包放到 DEBUG 方便本地调试；CONSOLE + FILE 双写 -->
        <logger name="com.blog" level="DEBUG"/>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ASYNC_FILE_WARN"/>
        </root>
    </springProfile>

</configuration>
