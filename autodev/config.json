{
  "_comment": "autodev-flow 项目配置文件 - my-blog",

  "project": {
    "_comment": "项目基本信息",
    "name": "blog-parent",
    "nameEn": "My Blog",
    "workspace": "项目根目录"
  },

  "modules": {
    "_comment": "项目模块结构（用于编译检查、文件定位）",
    "backend": "backend",
    "frontend": "frontend",
    "app": "blog-app",
    "article": "blog-article",
    "comment": "blog-comment",
    "settings": "blog-settings",
    "common": "blog-common",
    "auth": "blog-auth"
  },

  "database": {
    "_comment": "数据库配置",
    "type": "SQLite",
    "devFile": "blog.db"
  },

  "techStack": {
    "_comment": "技术栈（用于代码审查规则、编译命令）",
    "backend": "Spring Boot",
    "orm": "MyBatis-Plus",
    "frontend": "Nuxt 3",
    "language": ["Java", "TypeScript"],
    "cache": "Redis"
  },

  "ports": {
    "_comment": "服务端口（用于启动检查、API 调用）",
    "backend": 8080,
    "frontend": 3000,
    "redis": 6379
  },

  "api": {
    "_comment": "API 配置（用于健康检查、接口调用）",
    "prefix": "/api/v1",
    "healthCheck": "/articles/categories"
  },

  "docs": {
    "_comment": "文档路径（用于文档同步）",
    "design": "docs/design/博客系统设计方案.md",
    "readme": "README.md",
    "agents": "AGENTS.md"
  },

  "docker": {
    "_comment": "Docker 配置（用于集成测试启动服务）",
    "redisImage": "redis:7-alpine",
    "containerName": "blog-redis"
  }
}
